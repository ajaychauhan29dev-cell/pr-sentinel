# --- GitHub ------------------------------------------------------------------
# Fine-grained token with Pull requests: read/write, Issues: read/write, Contents: read.
# Leave empty to run the offline demo (fixture PR demo/acme-shop#42, dry-run forced).
GITHUB_TOKEN=
# GitHub Enterprise: https://ghe.example.com/api/v3
GITHUB_API_URL=
# Secret configured on the repository / GitHub App webhook (apps/web /api/webhooks/github)
GITHUB_WEBHOOK_SECRET=

# --- LLM provider: mock | openai | anthropic -----------------------------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio, gateways)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- MCP server behaviour -------------------------------------------------------
# true = record comments/labels in an outbox instead of writing to GitHub
SENTINEL_DRY_RUN=true
# {files} is replaced by the affected test files (argv, no shell)
SENTINEL_TEST_COMMAND=node --test --test-reporter=tap {files}
SENTINEL_TEST_TIMEOUT_MS=120000
# Where PR head commits are checked out for test runs
SENTINEL_WORKSPACE_DIR=.sentinel-workspaces
# Optional sandboxed install step after checkout, e.g. "npm ci --ignore-scripts"
SENTINEL_INSTALL_COMMAND=
# Force the bundled fixture PR even when GITHUB_TOKEN is set
SENTINEL_DEMO=false
# Path to sentinel.config.json used by the web app (defaults to repo root)
SENTINEL_CONFIG=
